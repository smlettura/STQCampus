# Copie este archivo como agente.env (mismo directorio que agente_stq.py) y complete los valores.
# NO lo suba al repositorio: contiene el token.
STQ_URL=https://su-dominio
STQ_TOKEN=pegue-aqui-el-token
OLLAMA_URL=http://127.0.0.1:11434
MODELO=stq-copiloto
# (o MODELO=gemma2:9b si no crearon stq-copiloto; debe coincidir con IA_MODELO del servidor)
ESPERA=10
TIMEOUT_OLLAMA=900
# En Windows (pythonw, sin consola) conviene:
# LOG_ARCHIVO=agente.log
