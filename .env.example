# Copie este archivo como .env y ajuste los valores. El archivo .env NUNCA se sube al repositorio.
# En AWS estos valores se guardan en Secrets Manager (secreto JSON indicado en AWS_SECRETS_ID) y la aplicación
# los carga al iniciar. La instancia EC2 accede con su rol de IAM: no se usan claves de acceso de AWS.
AWS_REGION=us-east-1
AWS_SECRETS_ID=

# ---------------------------------------------------------------- Django
DJANGO_DEBUG=1
# Genere una con: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Solo con DJANGO_DEBUG=0: 0 permite probar sin TLS en el propio equipo. En producción debe quedar en 1.
HTTPS_OBLIGATORIO=1
SESION_MINUTOS=30
LOG_LEVEL=INFO

# ---------------------------------------------------------------- base de datos
# sqlite (arranque rápido) o mysql (MySQL 8.4 local, igual que Amazon RDS for MySQL)
DB_ENGINE=sqlite
DB_NAME_SQLITE=db.sqlite3
DB_NAME=bienestar
DB_HOST=127.0.0.1
DB_PORT=3306
# Usuario con el que corre la aplicación (sin UPDATE/DELETE sobre la bitácora)
DB_USER=bienestar_app
DB_PASSWORD=Cambiar_App_2026
# Certificado para TLS con Amazon RDS (en la imagen: /app/certs/rds-global-bundle.pem). Vacío en local.
DB_SSL_CA=
# Usuario propietario del esquema: solo para migrar y otorgar permisos (docker/entrypoint.sh)
DB_MIGRA_USER=bienestar_migra
DB_MIGRA_PASSWORD=Cambiar_Migra_2026

# ---------------------------------------------------------------- cifrado de datos sensibles
# Formato: id:clave_base64_de_32_bytes[,id_anterior:clave_anterior]. La primera es la activa; las demás solo descifran.
# Genere una con: python manage.py generar_clave_cifrado --id v1
# Si queda vacía y DJANGO_DEBUG=1 se deriva una clave de DJANGO_SECRET_KEY (solo desarrollo).
CIFRADO_CLAVES=

# ---------------------------------------------------------------- almacenamiento de archivos
# local (carpetas del equipo) o s3 (AWS: buckets privados con SSE-KMS; la bitácora en un bucket con Object Lock)
ALMACENAMIENTO=local
ADJUNTOS_DIR=
BITACORA_EXPORT_DIR=
AWS_S3_ADJUNTOS=
AWS_S3_BITACORA=
AWS_KMS_KEY_ID=
ADJUNTO_MAX_MB=10

# ---------------------------------------------------------------- acceso
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# ---------------------------------------------------------------- correo (los avisos no incluyen datos del estudiante)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Plataforma de Bienestar <no-responder@colegio.cl>
URL_PLATAFORMA=http://localhost:8000

# ---------------------------------------------------------------- reglas del negocio
AVISO_REEVALUACION_DIAS=60
# Plazo para responder solicitudes ARCO+. Confírmelo con el plazo legal vigente antes de producción.
ARCO_PLAZO_DIAS=30
# Las tareas se ejecutan con «python manage.py ejecutar_tarea diaria|mensual» (EventBridge Scheduler + Systems Manager).
# TAREAS_TOKEN solo habilita el punto HTTP de respaldo POST /tareas/<nombre>/; déjelo vacío en producción.
TAREAS_TOKEN=

# ---------------------------------------------------------------- módulo de IA
# Gemma 2 9B se usa sin reentrenamiento, configurado con un Modelfile en el equipo de IA (docs/ia/Modelfile).
# La plataforma no usa servicios de IA externos ni necesita claves de proveedor.
