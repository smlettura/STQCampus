# Proxy inverso del origen (EC2). Termina el TLS del tramo CloudFront → instancia y pasa a Gunicorn por la red
# interna de Docker. Las variables ${...} las reemplaza la imagen oficial de nginx al iniciar (envsubst).
#
# - CloudFront valida el certificado del origen contra una autoridad pública y contra el nombre del origen
#   (no acepta certificados autofirmados): por eso el certificado es de Let's Encrypt para ${DOMINIO_ORIGEN}.
# - CloudFront negocia con el origen como máximo TLSv1.2 (OriginSslProtocols: SSLv3, TLSv1, TLSv1.1, TLSv1.2).
#   Se habilitan TLSv1.2 y TLSv1.3; el tramo CloudFront → origen usará TLSv1.2.

server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;              # rechaza conexiones que no pidan el nombre del origen
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMINIO_ORIGEN};

    ssl_certificate     /etc/letsencrypt/live/${DOMINIO_ORIGEN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMINIO_ORIGEN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_session_cache shared:origen:5m;

    client_max_body_size 12m;             # igual que DATA_UPLOAD_MAX_MEMORY_SIZE de Django
    server_tokens off;

    # Defensa adicional al grupo de seguridad: CloudFront agrega este encabezado (custom origin header).
    if ($http_x_origen_stq != "${CLAVE_ORIGEN}") {
        return 403;
    }

    location / {
        proxy_pass http://app:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Origen-STQ "";  # el secreto no llega a la aplicación
        proxy_read_timeout 60s;
    }
}
